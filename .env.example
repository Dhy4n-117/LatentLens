# Copy to `.env` and adjust. Every setting is optional.

LATENTLENS_DATA_DIR=data
LATENTLENS_ENCODER_MODEL_ID=facebook/vjepa2-vitl-fpc64-256
LATENTLENS_DEVICE=auto            # auto | cpu | cuda | mps
LATENTLENS_FRAMES_PER_CLIP=16     # must be even (V-JEPA tubelet size = 2)
LATENTLENS_WINDOW_SEC=4.0
LATENTLENS_STRIDE_SEC=2.0
LATENTLENS_BATCH_SIZE=4
LATENTLENS_RESIZE_SHORT_SIDE=256

# Phase 2: language bridge (Gemini free tier — https://aistudio.google.com/apikey)
GEMINI_API_KEY=
LATENTLENS_GEMINI_MODEL=gemini-2.5-flash
LATENTLENS_GEMINI_RPM=10          # stay under the free-tier requests/minute quota
LATENTLENS_KEYFRAMES_PER_CLIP=3
